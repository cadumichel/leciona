rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só acessa o próprio documento.
    // As cópias de segurança (users/{uid}/backups/...) não casam com esta regra e ficam bloqueadas
    // para o app: só o servidor do conector (Firebase Admin) as lê e grava.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // O app sempre grava o documento inteiro, com estes campos (inclusive "Excluir todos os
      // dados", que grava o documento vazio). O Firestore já limita o documento a 1 MiB.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['profile', 'schools', 'settings'])
        && request.resource.data.profile is map
        && request.resource.data.schools is list
        && request.resource.data.settings is map;

      // O app nunca apaga o documento; impedir evita perder tudo por engano
      allow delete: if false;
    }

    // Bloqueia tudo que não foi explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
